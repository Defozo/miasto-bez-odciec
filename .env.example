# Public configuration only. Inject secrets from psst, do not store them here.
DATA_MODE=fixture
SMART_CITY_LOCAL_DEMO_AUTH=false
SMART_CITY_PUBLIC_MODE=true
STORAGE_PATH=/data/evidence
SMART_CITY_SOURCE_HOSTS=krakow.pl,www.krakow.pl,zdmk.krakow.pl,ztp.krakow.pl,overpass-api.de
SMART_CITY_ENABLE_GROQ=false
SMART_CITY_ENABLE_FIRECRAWL=false
SMART_CITY_GROQ_MODEL=openai/gpt-oss-120b
SMART_CITY_ADAPTER_DAILY_CALL_LIMIT=100
SMART_CITY_DOMAIN=localhost
# Required secret names: SMART_CITY_DB_PASSWORD, SMART_CITY_APP_SECRET,
# SMART_CITY_OPERATOR_PASSWORD, SMART_CITY_VERIFIER_PASSWORD, SMART_CITY_ADMIN_PASSWORD.
# Optional provider secrets: GROQ_API_KEY, FIRECRAWL_API_KEY.
# DATABASE_URL is assembled at runtime from SMART_CITY_DB_PASSWORD by scripts/start-container.py.
